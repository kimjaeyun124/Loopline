{
  "name": "mosaic-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "remote:control": "node remote-control.mjs",
    "desktop": "electron .",
    "native:start": "npm --prefix native/LooplineNative start",
    "native:macos": "npm --prefix native/LooplineNative run macos",
    "native:build": "npm --prefix native/LooplineNative run build:macos",
    "native:ios": "npm --prefix native/LooplineNative run ios",
    "native:build:ios": "npm --prefix native/LooplineNative run build:ios",
    "build:langgraph": "esbuild harness-graph-runtime.mjs --bundle --platform=node --format=esm --outfile=dist/langgraph-runtime.bundle.mjs",
    "build:mcp": "esbuild mcp-runtime-entry.mjs --bundle --platform=node --format=esm --outfile=dist/mcp-runtime.bundle.mjs",
    "desktop:package": "npm run build:langgraph && npm run build:mcp && electron-builder --mac dir --arm64"
  },
  "productName": "Loopline",
  "build": {
    "appId": "com.mosaic.desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "harness-engine.mjs",
        "to": "app-server/harness-engine.mjs"
      },
      {
        "from": "harness-graph.mjs",
        "to": "app-server/harness-graph.mjs"
      },
      {
        "from": "dist/langgraph-runtime.bundle.mjs",
        "to": "app-server/langgraph-runtime.bundle.mjs"
      },
      {
        "from": "server.mjs",
        "to": "app-server/server.mjs"
      },
      {
        "from": "remote-control.mjs",
        "to": "app-server/remote-control.mjs"
      },
      {
        "from": "remote-control-auth.mjs",
        "to": "app-server/remote-control-auth.mjs"
      },
      {
        "from": "codex-app-server.mjs",
        "to": "app-server/codex-app-server.mjs"
      },
      {
        "from": "api-connections.mjs",
        "to": "app-server/api-connections.mjs"
      },
      {
        "from": "mcp-connections.mjs",
        "to": "app-server/mcp-connections.mjs"
      },
      {
        "from": "dist/mcp-runtime.bundle.mjs",
        "to": "app-server/mcp-runtime.bundle.mjs"
      },
      {
        "from": "conversation-history.mjs",
        "to": "app-server/conversation-history.mjs"
      },
      {
        "from": "usage-activity.mjs",
        "to": "app-server/usage-activity.mjs"
      },
      {
        "from": "token-usage.mjs",
        "to": "app-server/token-usage.mjs"
      },
      {
        "from": "public",
        "to": "app-server/public"
      },
      {
        "from": "agent-plugins.mjs",
        "to": "app-server/agent-plugins.mjs"
      },
      {
        "from": "browser-qa.mjs",
        "to": "app-server/browser-qa.mjs"
      },
      {
        "from": "harness-evidence.mjs",
        "to": "app-server/harness-evidence.mjs"
      },
      {
        "from": "harness-milestones.mjs",
        "to": "app-server/harness-milestones.mjs"
      }
    ],
    "mac": {
      "icon": "desktop/assets/loopline.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ChatGPT 또는 Gemini에서 음성 입력과 음성 대화를 사용할 때 마이크에 접근합니다.",
        "NSCameraUsageDescription": "ChatGPT 또는 Gemini에서 사용자가 선택한 카메라 기능을 사용할 때 카메라에 접근합니다."
      },
      "identity": null
    }
  },
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.18",
    "@modelcontextprotocol/client": "^2.2.0"
  }
}
